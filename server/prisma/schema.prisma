generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  passwordHash   String
  role           Role            @default(STAFF)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  inflows        CashInflow[]
  sales          Sale[]
  outflows       CashOutflow[]
  auditLogs      AuditLog[]
  balanceRecords BalanceRecord[]
}

model CashInflow {
  id           String   @id @default(cuid())
  amount       Decimal  @db.Decimal(15, 2)
  slipNumber   String   @unique
  customerName String
  remarks      String?
  date         String
  time         String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
}

model Sale {
  id           String   @id @default(cuid())
  productName  String
  amount       Decimal  @db.Decimal(15, 2)
  customerName String
  notes        String?
  date         String
  time         String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
}

model CashOutflow {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(15, 2)
  reason    String
  notes     String?
  date      String
  time      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  tableName String
  recordId  String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model BalanceRecord {
  id             String   @id @default(cuid())
  date           String   // Format YYYY-MM-DD
  openingTime    String   // Format hh:mm:ss AM/PM
  openingBalance Decimal  @db.Decimal(15, 2)
  closingTime    String?  // Format hh:mm:ss AM/PM
  closingBalance Decimal? @db.Decimal(15, 2)
  
  status         String   @default("UNVERIFIED") // UNVERIFIED, APPROVED, FLAGGED
  remarks        String?  // Admin or audit notes
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user           User     @relation(fields: [userId], references: [id])
  userId         String

  @@unique([userId, date])
}

